PORT=3000
NODE_ENV=development
# Replace this before deploying outside localhost. Use at least 32 random bytes.
SESSION_SECRET=change-this-to-a-long-random-secret
# Optional: enables source-grounded material, question, and flashcard generation.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini
# Optional: password recovery email. Without SMTP, password changes require a signed-in session.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
